{
  "cleanUrls": true,
  "functions": { "api/*.js": { "includeFiles": "{collections.json,data/holders.json}", "maxDuration": 20 } },
  "headers": [
    { "source": "/partners/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
